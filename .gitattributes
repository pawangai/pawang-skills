# Normalisasi line ending: semua teks disimpan LF.
* text=auto eol=lf

# Skrip harus LF agar shebang tidak rusak di Windows.
*.sh  text eol=lf
*.py  text eol=lf

# Biner (tidak di-diff, tidak dinormalisasi).
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.pdf   binary
*.zip   binary
*.skill binary

# Git LFS sengaja tidak dipakai: repo ini tidak menyimpan biner.
# Bila nanti perlu aset besar, jangan masukkan ke main. Urutan pilihan:
# Git LFS, lalu object storage + CDN, lalu branch orphan (aset kecil).
